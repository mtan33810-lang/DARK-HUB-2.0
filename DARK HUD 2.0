--============================================================
-- CHARACTER / TOOL HANDLING
--============================================================

LocalPlayer.CharacterAdded:Connect(function(Character)
    local Humanoid =
        Character:WaitForChild("Humanoid", 10)

    if Humanoid then
        task.wait(0.5)

        if autoEquipCan then
            equipWaterCan()
        end
    end
end)

local Backpack =
    LocalPlayer:WaitForChild("Backpack")

Backpack.ChildAdded:Connect(function(Tool)
    if not autoEquipCan then
        return
    end

    if not Tool:IsA("Tool") then
        return
    end

    if containsIgnoreCase(Tool.Name, "water") then
        task.wait(0.1)
        equipWaterCan()
    end
end)

--============================================================
-- THEMES TAB
--============================================================

local ThemesTab = Window:CreateTab(
    "Themes",
    4483362458
)

ThemesTab:CreateSection("Themes")

local Themes = {
    "Default",
    "AmberGlow",
    "Amethyst",
    "Bloom",
    "DarkBlue",
    "Green",
    "Light",
    "Ocean",
    "Serenity"
}

for _, ThemeName in ipairs(Themes) do
    ThemesTab:CreateButton({
        Name = ThemeName,

        Callback = function()
            Window.ModifyTheme(ThemeName)

            Rayfield:Notify({
                Title = "Theme Changed",
                Content = "Theme: " .. ThemeName,
                Duration = 2
            })
        end
    })
end
