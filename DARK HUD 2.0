    Callback = function(Value)
        autoBuyGear = Value

        if Value then
            task.spawn(function()
                while autoBuyGear do
                    local Remote =
                        getEvent("BuyGearStock")

                    if Remote then
                        Remote:FireServer(selectedGear)
                    end

                    task.wait(1)
                end
            end)
        end
    end
})

--============================================================
-- PET EGG SHOP
--============================================================

local Section = EventTab:CreateSection("EGG SHOP")

local PetEggs = {
    "Common Egg",
    "Uncommon Egg",
    "Rare Egg",
    "Legendary Egg",
    "Mythical Egg",
    "Bug Egg",
    "Jungle Egg"
}

local selectedPetEgg = PetEggs[1]
local autoBuyPetEgg = false

ShopTab:CreateDropdown({
    Name = "Select Pet Egg",
    Options = PetEggs,
    CurrentOption = {selectedPetEgg},
    MultipleOptions = false,
    Flag = "SelectedPetEgg",

    Callback = function(Value)
        local Selection = convertSelection(Value)

        selectedPetEgg =
            Selection[1] or PetEggs[1]
    end
})

ShopTab:CreateToggle({
    Name = "Auto Buy Selected Pet Egg",
    CurrentValue = false,
    Flag = "AutoBuyPetEgg",

    Callback = function(Value)
        autoBuyPetEgg = Value

        if Value then
            task.spawn(function()
                while autoBuyPetEgg do
                    local Remote =
                        getEvent("BuyPetEgg")

                    if Remote then
                        Remote:FireServer(selectedPetEgg)
                    end

                    task.wait(1)
                end
            end)
        end
    end
})

--============================================================
-- AUTOMATICALLY TAB
--============================================================

local AutomaticallyTab = Window:CreateTab(
    "Automatically",
    4483362458
)

--============================================================
-- AUTO WATER UI
--============================================================

AutomaticallyTab:CreateSection("Auto Water")

AutomaticallyTab:CreateToggle({
    Name = "Auto Water Plants",
    CurrentValue = false,
    Flag = "AutoWater",

    Callback = function(Value)
        autoWaterEnabled = Value

        Rayfield:Notify({
            Title = "Auto Water",
            Content = Value
                and "Auto watering enabled."
                or "Auto watering disabled.",
            Duration = 2
        })
    end
})

AutomaticallyTab:CreateToggle({
    Name = "Auto Equip Water Can",
    CurrentValue = false,
    Flag = "AutoEquipWaterCan",

    Callback = function(Value)
        autoEquipCan = Value

        if Value then
            equipWaterCan()
        end
    end
})

AutomaticallyTab:CreateDropdown({
    Name = "Select Water Can",
    Options = WaterCans,
    CurrentOption = {selectedWaterCan},
    MultipleOptions = false,
    Flag = "SelectedWaterCan",

    Callback = function(Value)
        local Selection = convertSelection(Value)

        selectedWaterCan =
            Selection[1] or "Water Can"

        if autoEquipCan then
            equipWaterCan()
        end
    end
})

AutomaticallyTab:CreateDropdown({
    Name = "Select Plants To Water",
    Options = getUniquePlantNames(),
    CurrentOption = {},
    MultipleOptions = true,
    Flag = "SelectedWaterPlants",

    Callback = function(Value)
        selectedWaterPlants =
            convertSelection(Value)
    end
})

AutomaticallyTab:CreateButton({
    Name = "Refresh Plant List",
    Callback = function()
        local Dropdown = AutomaticallyTab:CreateDropdown({
            Name = "Temporary",
            Options = getUniquePlantNames(),
            CurrentOption = {},
            MultipleOptions = true
        })

        task.wait()

        if Dropdown then
            Dropdown:Set(getUniquePlantNames())
        end
    end
})

AutomaticallyTab:CreateSlider({
    Name = "Water Radius",
    Range = {10, 500},
    Increment = 10,
    Suffix = " Studs",
    CurrentValue = 100,
    Flag = "WaterRadius",

    Callback = function(Value)
        waterRadius = Value
    end
})

AutomaticallyTab:CreateSlider({
    Name = "Water Speed",
    Range = {0.05, 2},
    Increment = 0.05,
    Suffix = " sec",
    CurrentValue = 0.2,
    Flag = "WaterSpeed",

    Callback = function(Value)
        waterCooldown = Value
    end
})

