--============================================================
-- SERVICES
--============================================================

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

--============================================================
-- GAME EVENTS
--============================================================

local GameEvents = ReplicatedStorage:WaitForChild("GameEvents")

local function getEvent(name)
    return GameEvents:FindFirstChild(name)
end

--============================================================
-- CHARACTER HELPERS
--============================================================

local function getCharacter()
    return LocalPlayer.Character
end

local function getHumanoid()
    local Character = getCharacter()
    return Character and Character:FindFirstChildOfClass("Humanoid")
end

local function getRootPart()
    local Character = getCharacter()
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

--============================================================
-- PLANT CONTAINER
--============================================================

local function getPlantsPhysical()
    local Farm = Workspace:FindFirstChild("Farm")

    if not Farm then
        return nil
    end

    local NestedFarm = Farm:FindFirstChild("Farm")

    if NestedFarm then
        local Important = NestedFarm:FindFirstChild("Important")

        if Important then
            local Plants = Important:FindFirstChild("Plants_Physical")

            if Plants then
                return Plants
            end
        end
    end

    return Farm:FindFirstChild("Plants_Physical", true)
end

