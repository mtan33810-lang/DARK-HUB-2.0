local autoBeanstalk = false

EventTab:CreateToggle({
    Name = "Auto Submit All Plants",
    CurrentValue = false,
    Flag = "AutoBeanstalk",

    Callback = function(Value)
        autoBeanstalk = Value

        if Value then
            task.spawn(function()
                while autoBeanstalk do
                    local Events = GameEvents:FindFirstChild("Events")

                    local BeanstalkEvent =
                        Events
                        and Events:FindFirstChild("BeanstalkEvent")

                    local Submit =
                        BeanstalkEvent
                        and BeanstalkEvent:FindFirstChild(
                            "BeanstalkRESubmitAllPlant"
                        )

                    if Submit then
                        Submit:FireServer()
                    end

                    task.wait(10)
                end
            end)
        end
    end
})

